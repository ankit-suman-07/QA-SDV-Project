{
  "container_name": "autonomoushealthapp-vehicle-002",
  "image": {
    "name": "registry.example.invalid/sdv/autonomous-health-app:v1-contract-1.0.0-example"
  },
  "host_config": {
    "devices": [],
    "network_mode": "host",
    "privileged": false,
    "restart_policy": {
      "type": "unless-stopped",
      "maximum_retry_count": 0,
      "retry_timeout": 0
    }
  },
  "config": {
    "env": [
      "SDV_MIDDLEWARE_TYPE=native",
      "SDV_VEHICLEDATABROKER_ADDRESS=grpc://192.0.2.10:55557",
      "SDV_MQTT_ADDRESS=mqtt://192.0.2.10:1883",
      "DATABROKER_HOST=192.0.2.10",
      "DATABROKER_PORT=55557",
      "SIMULATED_VEHICLE_ID=vehicle-002",
      "AUTONOMOUS_HEALTH_POLL_INTERVAL_SECONDS=2.0"
    ]
  }
}
