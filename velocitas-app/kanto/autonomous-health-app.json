{
    "container_name": "autonomoushealthapp",
    "image": {
      "name": "localhost:12345/autonomoushealthapp:local"
    },
    "host_config": {
      "devices": [],
      "network_mode": "host",
      "privileged": false,
      "restart_policy": {
        "maximum_retry_count": 0,
        "retry_timeout": 0,
        "type": "unless-stopped"
      }
    },
    "config": {
      "env": [
        "SDV_MIDDLEWARE_TYPE=native",
        "SDV_VEHICLEDATABROKER_ADDRESS=grpc://127.0.0.1:55555",
        "SDV_MQTT_ADDRESS=mqtt://127.0.0.1:1883",
        "DATABROKER_HOST=127.0.0.1",
        "DATABROKER_PORT=55555",
        "SIMULATED_VEHICLE_ID=vehicle-001",
        "AUTONOMOUS_HEALTH_POLL_INTERVAL_SECONDS=2.0"
      ]
    }
  }