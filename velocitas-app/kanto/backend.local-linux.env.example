# Secret-free same-device backend configuration. Load credentials separately.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=18081
SDV_VEHICLE_IDS=vehicle-001,vehicle-002
SDV_V1_DITTO_MODE=live
SDV_V1_DITTO_BASE_URL=http://127.0.0.1:18080
SDV_PROVIDER_001_BASE_URL=http://127.0.0.1:8091
SDV_PROVIDER_002_BASE_URL=http://127.0.0.1:8092
# Only one Spring Boot instance may materialize fleet. It stays disabled in prep.
SDV_V1_FLEET_ENABLED=false
