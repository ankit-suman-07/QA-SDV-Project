{
  "manifestVersion": "v3",
  "name": "AutonomousHealthApp",
  "interfaces": [
    {
      "type": "vehicle-signal-interface",
      "config": {
        "src": "https://github.com/COVESA/vehicle_signal_specification/releases/download/v4.0/vss_rel_4.0.json",
        "datapoints": {
          "required": [
            {
              "path": "Vehicle.Speed",
              "access": "read"
            }
          ]
        }
      }
    },
    {
      "type": "pubsub",
      "config": {
        "reads": [],
        "writes": [
          "sdv/autonomy/status",
          "sdv/+/health"
        ]
      }
    }
  ]
}
